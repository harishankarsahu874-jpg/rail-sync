# RailSync external data providers
# Copy this file to .env, insert your own keys, then run: bash scripts/run.sh
# Never commit .env. Server keys stay in FastAPI; VITE_* keys are embedded in
# browser JavaScript and should be restricted to your deployment origins.

# Live Indian train telemetry: https://railradar.in/docs
RAILRADAR_API_KEY=

# MapTiler MapLibre basemap (public browser key): https://cloud.maptiler.com/account/keys/
VITE_MAPTILER_API_KEY=
# Map style slug, e.g. basic-v2-dark or hybrid-v4.
VITE_MAPTILER_STYLE=basic-v2-dark
# NOTE: VITE_* values are baked into the browser bundle by the Vite build.
# On Render they must be present BEFORE the deploy build runs; a restart alone
# never updates them. If a MapTiler key is rejected (403) the map automatically
# falls back to free OSM/CARTO raster tiles.

# Current weather observations: https://openweathermap.org/api
OPENWEATHER_API_KEY=

# COP30 point elevation: https://opentopography.org/developers
OPENTOPOGRAPHY_API_KEY=
OPENTOPOGRAPHY_DATASET=COP30

# Reverse geocoding (public browser key): https://myprojects.geoapify.com/
VITE_GEOAPIFY_API_KEY=

# Overpass uses OpenStreetMap data and requires no key.
OVERPASS_URL=https://overpass-api.de/api/interpreter

# Quota controls. RailRadar's free sandbox is 1,000 calls/month, so fleet-wide
# background sync is OFF by default. A selected train can still be synced from
# the UI and is cached for five minutes.
# Leave false on RailRadar's free sandbox (1,000 calls/month): live pages
# already sync themselves on open + every 5 min while open (server-cached).
RAILRADAR_AUTO_SYNC=false
RAILRADAR_POLL_SECONDS=900
RAILRADAR_CACHE_SECONDS=300
# Raw provider coordinates expire before longer route-based dead reckoning.
RAILRADAR_REPORTED_POSITION_TTL_SECONDS=600
RAILRADAR_POSITION_TTL_SECONDS=1800
OPENWEATHER_POLL_SECONDS=600
